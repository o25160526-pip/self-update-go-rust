{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rust-demo",
  "version": "1.0.0",
  "identifier": "com.example.rust-demo",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "windows": [{ "label": "main", "title": "Rust Demo - Auto Update", "width": 800, "height": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
