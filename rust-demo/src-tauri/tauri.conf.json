    "updater": {
      "active": true,
      "endpoints": ["https://github.com/o25160526-pip/self-update-go-rust/releases/latest/download/latest-rust.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NTZEQjVBMzUwOUE4QzEKUldUQnFBazFXdHRXVjgvL3ZSVks0Ky9EaVhWTTQ5aVJpeTBuNDdzZUlFS0p0SlhGYmZVWkYrN0oK",
      "windows": { "installMode": "passive" }
    }
  }
}
